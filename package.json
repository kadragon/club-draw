{
  "name": "club-draw",
  "version": "1.10.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "deploy": "bun run build && wrangler deploy",
    "cf:dev": "bun run build && wrangler dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
